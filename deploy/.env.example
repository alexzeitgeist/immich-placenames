# Copy credentials from the existing Immich database configuration.
# DB_URL, when set, replaces the five variables below.
#DB_URL=
DB_HOSTNAME=database
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE_NAME=immich
IMMICH_NETWORK=immich_default
IMMICH_PLACENAMES_IMAGE=immich-placenames:local
IMMICH_PLACENAMES_DATA=./data
